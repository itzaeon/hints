# open terminal
super + Return
  alacritty

# open browser
super + @t
  librewolf

# switch between desktops
super + {_,shift + }{1-5,0}
  bspc {desktop -f,node -d} '^{1-5,10}'paces 

# quit wm
super + shift + e
  bspc quit

# restart wm
super + shift + r
  bspc wm -r; pkill -USR1 -x sxhkd

# toggle floating mode
super + shift + space
  bspc node -t {floating,tiled}

# close window
super + q
  bspc node -{c,k}

# switch between windows
alt + Tab
  bspc node -f next.local.!hidden.window

# resize window
super + {Up,Down,Left,Right}
  {bspc node -z top 10 10; bspc node -z bottom -10 -10, bspc node -z bottom 10 10; bspc node -z top -10 -10, bspc node -z left 10 10; bspc node -z right -10 -10, bspc node -z right 10 10; bspc node -z left -10 -10 }

# change window position
super + shift + {Up,Down,Left,Right}
  bspc node -s {north,south,west,east}

# show help menu
super + slash
  sxhkd-help
